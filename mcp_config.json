{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "@quantgeek/docker-mcp"
      ]
    }
  }
}
